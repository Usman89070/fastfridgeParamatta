# Hostinger Production .htaccess - Fridge Repair Parramatta

# Enable Rewrite Engine
RewriteEngine On

# 1. Force HTTPS (SSL Security)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. URL Rewriting for URL Slug: /fridge-repair-parramatta/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^fridge-repair-parramatta/?$ index.html [L,QSA]

# 2b. Blog admin panel - transparently serve the dynamic blog pages under
# their existing static-looking URLs, so every internal link, external
# link and search-engine listing built around the old static filenames
# keeps working with zero changes anywhere else on the site.
RewriteRule ^blog\.html$ blog.php [L,QSA]
RewriteRule ^blog-([a-z0-9-]+)\.html$ blog-post.php?slug=$1 [L,QSA]

# 2c. Block direct web access to backend-only folders and files. These are
# only ever loaded via PHP `require`, never requested directly by a browser.
RewriteRule ^admin/includes/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^database/ - [F,L]
<FilesMatch "\.(sql|sqlite)$">
  Require all denied
</FilesMatch>
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

# Set Default Index Document
DirectoryIndex index.html

# 3. Gzip Compression for Fast Loading Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 4. Leverage Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# 5. Production Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
